MISTRAL_API_KEY=

# Nodig om de volledige artikeltekst apart van de publieke JSON op te slaan
# (echte paywall, Fase 1.4). Vind hem in het Supabase-dashboard onder
# Project Settings → API → service_role secret. NOOIT in de browser gebruiken
# en nooit committen — alleen lokaal in .env of als GitHub Secret.
SUPABASE_SERVICE_ROLE_KEY=

# Alleen nodig voor `npm run mail-test` (backend/mailer.js). SMTP-inloggegevens
# van het Strato-mailaccount dat de bevestigingsmail na aankoop verstuurt.
EMAIL_USER=
EMAIL_PASS=
